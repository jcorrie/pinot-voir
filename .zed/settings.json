{
  "enable_language_server": true,
  "format_on_save": "on",
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "procMacro": {
          "enable": true,
        },
        "check": {
          "command": "clippy",
          "allTargets": false,
          "rust.target": "thumbv7em-none-eabihf",
        },
        "cargo": {
          "buildScripts": {
            "enable": true,
          },
        },
      },
    },
  },
}
